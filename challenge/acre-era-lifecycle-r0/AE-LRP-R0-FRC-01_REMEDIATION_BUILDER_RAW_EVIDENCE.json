  "remediationDesign": {
    "mechanism": "DB-enforced monotonic Era content_revision plus transactional snapshot construction and closure CAS",
    "migration": "drizzle/0015_era_closure_snapshot_consistency_r0.sql",
    "protectedSnapshotContributors": [
      "products referenced by Era product memberships",
      "era_products memberships",
      "era_sections",
      "era_media_assets",
      "era_watchtower_bindings"
    ],
    "behavior": [
      "Every normal INSERT/UPDATE/DELETE of Era child snapshot state advances the owning eras.content_revision through PostgreSQL triggers.",
      "Product UPDATE/DELETE advances content_revision for every Era membership referencing the product.",
      "closeEra constructs the closure snapshot inside the close transaction.",
      "Snapshot construction re-reads eras.updated_at and eras.content_revision after child reads and fails closed if either changed.",
      "The final CLOSED transition CASes lifecycle_state, updated_at, and content_revision.",
      "If a child mutation commits before closure, the revision changes and closure rolls back, including any tentative archive snapshot.",
      "If closure wins the Era-row CAS first, a concurrent child trigger cannot commit until closure completes, so that mutation occurs after closure rather than before it."
    ]
  },
