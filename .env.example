# Norvana recovery environment
# Copy to .env.local for local development. Never commit real values.

DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NORVANA_SITE_URL=http://localhost:3000

# Temporary server-to-server recovery guard.
# Do not expose this value to browser code.
NORVANA_ADMIN_API_TOKEN=

# Consequential external actions remain off unless explicitly enabled
# after connector qualification, authority review, and live verification.
NORVANA_EXTERNAL_FULFILLMENT_ENABLED=false

# Future IgniAqua federation endpoint. Read/recommend mode first.
IGNIAQUA_FEDERATION_ENABLED=false
IGNIAQUA_FEDERATION_BASE_URL=
