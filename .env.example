# Norvana recovery environment
# Copy to .env.local for local development. Never commit real values.

DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NORVANA_SITE_URL=http://localhost:3000

# Temporary server-to-server recovery guard.
# Do not expose this value to browser code.
NORVANA_ADMIN_API_TOKEN=

# Consequential external actions remain off unless explicitly enabled
# after connector qualification, authority review, and live verification.
NORVANA_EXTERNAL_FULFILLMENT_ENABLED=false
NORVANA_SUPPLIER_CONNECTORS_ENABLED=false

# Future IgniAqua federation endpoint. Read/recommend mode first.
IGNIAQUA_FEDERATION_ENABLED=false
IGNIAQUA_FEDERATION_BASE_URL=

# Watchtower / owner control panel
NORVANA_ADMIN_PASSWORD_SALT=
NORVANA_ADMIN_PASSWORD_HASH=
NORVANA_ADMIN_SESSION_SECRET=
NORVANA_ADMIN_RECOVERY_ENABLED=false
NORVANA_ADMIN_RECOVERY_SECRET=
NORVANA_WATCHTOWER_CRON_SECRET=
NORVANA_WATCHTOWER_QUEUE_ENABLED=false
NORVANA_WATCHTOWER_EXECUTOR_ENABLED=false
NORVANA_WATCHTOWER_WORKER_SECRET=


# Acre Era pseudonymous watchlist/customer-intent HMAC.
# Use a strong deployment secret; never expose it to browser code.
NORVANA_CUSTOMER_INTENT_SECRET=


# Product-route activation economics. Both values are required for route ACT.
# Example only: set deliberate business policy before any live route activation.
NORVANA_ROUTE_MIN_CONTRIBUTION_CENTS=
NORVANA_ROUTE_MIN_MARGIN_BPS=


# Stock media discovery — admin-only search, never auto-approves media.
PIXABAY_API_KEY=
COVERR_API_KEY=

# Delivery provider credentials — reserved for future quote adapters.
# Do not enable consequential shipment creation without separate authority gates.
DOORDASH_DRIVE_CLIENT_ID=
DOORDASH_DRIVE_CLIENT_SECRET=
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
ROADIE_API_KEY=


# Public producer interest intake stays fail-closed until the inbox migration is approved.
PRODUCER_INTEREST_INTAKE_ENABLED=false
